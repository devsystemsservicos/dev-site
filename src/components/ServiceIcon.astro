---
/** Outlined line icons, drawn to match the brand's icon style. */
interface Props {
  name: "code" | "gear" | "cloud" | "chart" | "support";
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<Props["name"], string> = {
  code: '<path d="M9.2 6.4 4 12l5.2 5.6"/><path d="M14.8 6.4 20 12l-5.2 5.6"/><path d="M13.4 3.6 10.6 20.4"/>',
  gear: '<circle cx="12" cy="12" r="3.3"/><path d="M12 2.6v2.6M12 18.8v2.6M2.6 12h2.6M18.8 12h2.6M5.4 5.4l1.9 1.9M16.7 16.7l1.9 1.9M18.6 5.4l-1.9 1.9M7.3 16.7l-1.9 1.9"/>',
  cloud: '<path d="M7.2 18.4h9.6a3.6 3.6 0 0 0 .3-7.2 5.6 5.6 0 0 0-10.7-1.5 3.8 3.8 0 0 0 .8 8.7Z"/>',
  chart: '<path d="M4 20.2h16"/><path d="M7.4 20.2v-5.4"/><path d="M12 20.2v-8.6"/><path d="M16.6 20.2v-3.4"/><path d="M5.6 8.6 9.4 5l3.2 2.9 5.4-4.4"/>',
  support:
    '<path d="M4.4 13.2v-1a7.6 7.6 0 0 1 15.2 0v1"/><rect x="2.8" y="12.8" width="4.2" height="6.2" rx="2.1"/><rect x="17" y="12.8" width="4.2" height="6.2" rx="2.1"/><path d="M18.1 19v.6a2.6 2.6 0 0 1-2.6 2.6h-3.1"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
