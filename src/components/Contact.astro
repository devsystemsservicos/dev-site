---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { contact, whatsappLink } from "../data/site";

const prefill = "Olá! Gostaria de falar sobre um sistema para a minha empresa.";
---

<section class="section section--white" id="contacto" aria-labelledby="contacto-titulo">
  <div class="shell contact">
    <div class="contact__intro">
      <h2 class="head__title" id="contacto-titulo">Diga-nos o que está a travar</h2>
      <p class="head-split__lead">
        Descreva o processo que está lento, o sistema que não funciona ou a
        informação que nunca chega a quem precisa. Respondemos em menos de um dia útil.
      </p>

      <dl class="details">
        <div class="details__row">
          <dt>WhatsApp</dt>
          <dd>
            <a
              href={whatsappLink(prefill)}
              target="_blank"
              rel="noopener noreferrer">{contact.phoneDisplay}</a
            >
          </dd>
        </div>
        <div class="details__row">
          <dt>Email</dt>
          <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        </div>
        <div class="details__row">
          <dt>Onde estamos</dt>
          <dd>{contact.address}</dd>
        </div>
      </dl>

      <a
        class="btn btn--wa wa-cta"
        href={whatsappLink(prefill)}
        target="_blank"
        rel="noopener noreferrer"
      >
        <WhatsAppIcon size={19} /> Falar no WhatsApp
      </a>
    </div>

    <form class="form" data-contact-form novalidate>
      <div class="form__row">
        <div class="field">
          <label for="f-nome">Nome</label>
          <input id="f-nome" name="nome" type="text" autocomplete="name" required />
          <p class="field__error" data-error-for="nome" hidden></p>
        </div>
        <div class="field">
          <label for="f-empresa">Empresa</label>
          <input id="f-empresa" name="empresa" type="text" autocomplete="organization" />
        </div>
      </div>

      <div class="form__row">
        <div class="field">
          <label for="f-email">Email</label>
          <input
            id="f-email"
            name="email"
            type="email"
            autocomplete="email"
            spellcheck="false"
            required
          />
          <p class="field__error" data-error-for="email" hidden></p>
        </div>
        <div class="field">
          <label for="f-telefone">Telefone</label>
          <input
            id="f-telefone"
            name="telefone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
          />
        </div>
      </div>

      <div class="field">
        <label for="f-mensagem">O que precisa</label>
        <textarea
          id="f-mensagem"
          name="mensagem"
          rows="5"
          required
          placeholder="Ex.: A contabilidade e o estoque estão separados e o fecho de mês demora quatro dias…"></textarea>
        <p class="field__error" data-error-for="mensagem" hidden></p>
      </div>

      <button class="btn btn--wa form__submit" type="submit">
        <WhatsAppIcon size={19} /> Enviar por WhatsApp
      </button>

      <p class="form__note" data-form-note role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .details {
    margin: 2.25rem 0 0;
    display: grid;
    gap: 0;
  }

  .details__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--rule);
  }

  .details__row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .details__row dt {
    min-width: 8.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .details__row dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }

  /* ---- Form ---- */

  .form {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--mist);
    border: 1px solid var(--rule);
    border-radius: 10px;
  }

  .form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1.15rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.15rem;
  }

  .field label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink);
  }

  .field :is(input, textarea) {
    width: 100%;
    padding: 0.72rem 0.85rem;
    border: 1px solid #cfd7e3;
    border-radius: 5px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    transition: border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }

  .field textarea {
    resize: vertical;
    min-height: 7rem;
  }

  .field :is(input, textarea):focus-visible {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.16);
  }

  .field :is(input, textarea)[aria-invalid="true"] {
    border-color: #c0392b;
  }

  .field__error {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #a33124;
  }

  .form__submit {
    margin-top: 0.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .form__submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .form__note {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .form__note:empty {
    margin: 0;
  }

  .form__note[data-tone="ok"] {
    color: #0f5c4a;
    font-weight: 600;
  }

  .form__note[data-tone="error"] {
    color: #a33124;
    font-weight: 600;
  }

  @media (max-width: 56rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }

    .details__row {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>

<script>
  const form = document.querySelector("[data-contact-form]");
  if (form instanceof HTMLFormElement) {
    const note = form.querySelector("[data-form-note]");
    const submit = form.querySelector("button[type=submit]");

    const setNote = (text, tone) => {
      if (!(note instanceof HTMLElement)) return;
      note.textContent = text;
      if (tone) note.setAttribute("data-tone", tone);
      else note.removeAttribute("data-tone");
    };

    const fail = (name, message) => {
      const input = form.querySelector(`[name="${name}"]`);
      const slot = form.querySelector(`[data-error-for="${name}"]`);
      if (input) input.setAttribute("aria-invalid", "true");
      if (slot instanceof HTMLElement) {
        slot.textContent = message;
        slot.hidden = false;
      }
    };

    const clear = (name) => {
      const input = form.querySelector(`[name="${name}"]`);
      const slot = form.querySelector(`[data-error-for="${name}"]`);
      if (input) input.removeAttribute("aria-invalid");
      if (slot instanceof HTMLElement) {
        slot.hidden = true;
        slot.textContent = "";
      }
    };

    form.addEventListener("input", (e) => {
      const t = e.target;
      if (t instanceof HTMLElement && t.getAttribute("name")) clear(t.getAttribute("name"));
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      setNote("", null);

      const data = new FormData(form);
      const nome = String(data.get("nome") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const telefone = String(data.get("telefone") ?? "").trim();
      const empresa = String(data.get("empresa") ?? "").trim();
      const mensagem = String(data.get("mensagem") ?? "").trim();

      let firstBad = null;
      if (!nome) {
        fail("nome", "Escreva o seu nome.");
        firstBad ??= "nome";
      } else clear("nome");

      if (!email) {
        fail("email", "Precisamos de um email para lhe responder.");
        firstBad ??= "email";
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        fail("email", "Esse email não parece completo.");
        firstBad ??= "email";
      } else clear("email");

      if (!mensagem) {
        fail("mensagem", "Descreva em duas linhas o que precisa.");
        firstBad ??= "mensagem";
      } else clear("mensagem");

      if (firstBad) {
        setNote("Faltam campos para enviar o pedido.", "error");
        form.querySelector(`[name="${firstBad}"]`)?.focus();
        return;
      }

      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      setNote("A abrir WhatsApp…", null);

      // Build WhatsApp message
      const lines = [
        `Nome: ${nome}`,
        `Email: ${email}`,
        telefone ? `Telefone: ${telefone}` : "Telefone: —",
        empresa ? `Empresa: ${empresa}` : "Empresa: —",
        "",
        mensagem,
      ];
      const text = lines.join("\n");
      const waUrl = `https://wa.me/258862393272?text=${encodeURIComponent(text)}`;

      // Open WhatsApp with fallback for popup blockers
      const waOpened = window.open(waUrl, "_blank", "noopener,noreferrer");
      
      if (!waOpened || waOpened.closed || typeof waOpened.closed === "undefined") {
        // Popup blocked - fallback to direct link
        const fallbackLink = document.createElement("a");
        fallbackLink.href = waUrl;
        fallbackLink.target = "_blank";
        fallbackLink.rel = "noopener noreferrer";
        document.body.appendChild(fallbackLink);
        fallbackLink.click();
        document.body.removeChild(fallbackLink);
      }

      form.reset();
      setNote("WhatsApp aberto. Se não abrir, verifique o bloqueador de pop-ups.", "ok");

      if (submit instanceof HTMLButtonElement) submit.disabled = false;
    });
  }
</script>