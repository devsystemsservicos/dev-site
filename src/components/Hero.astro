---
/**
 * The one orchestrated moment on the page: a mesh of disconnected systems
 * wiring itself together on load, then a single packet crossing the link.
 * After that it holds still — no looping ambient motion.
 */

const nodes = [
  { id: "n1", x: 70, y: 84, hub: false },
  { id: "n2", x: 206, y: 48, hub: false },
  { id: "n3", x: 352, y: 96, hub: false },
  { id: "n4", x: 128, y: 208, hub: false },
  { id: "n5", x: 272, y: 190, hub: true },
  { id: "n6", x: 392, y: 232, hub: false },
  { id: "n7", x: 74, y: 330, hub: false },
  { id: "n8", x: 208, y: 366, hub: false },
  { id: "n9", x: 352, y: 330, hub: false },
];

const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));

const links = [
  ["n1", "n2"],
  ["n2", "n3"],
  ["n1", "n4"],
  ["n2", "n4"],
  ["n4", "n5"],
  ["n2", "n5"],
  ["n3", "n5"],
  ["n3", "n6"],
  ["n5", "n6"],
  ["n4", "n7"],
  ["n7", "n8"],
  ["n8", "n5"],
  ["n8", "n9"],
  ["n5", "n9"],
  ["n6", "n9"],
].map(([a, b], i) => ({ a: byId[a], b: byId[b], i }));
---

<section class="hero on-navy" id="inicio">
  <div class="hero__inner shell">
    <div class="hero__copy">
      <h1 class="hero__title">Sistemas ligados.<br />Processos simples.</h1>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__lead">
        Desenvolvemos, integramos e automatizamos a tecnologia do seu negócio — para
        que a equipa deixe de perder tempo entre folhas de cálculo, e-mails e sistemas
        que não se falam uns com os outros.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#contacto">Fale Conosco</a>
        <a class="btn btn--ghost" href="#solucoes">Ver soluções</a>
      </div>
    </div>

    <div class="hero__figure">
      <svg
        class="graph"
        viewBox="0 0 440 440"
        role="img"
        aria-label="Diagrama de sistemas isolados a ligar-se entre si"
      >
        <g class="graph__links">
          {
            links.map(({ a, b, i }) => (
              <line
                x1={a.x}
                y1={a.y}
                x2={b.x}
                y2={b.y}
                pathLength="1"
                style={`--i:${i}`}
              />
            ))
          }
        </g>

        <g class="graph__nodes">
          {
            nodes.map((n, i) => (
              <circle
                cx={n.x}
                cy={n.y}
                r={n.hub ? 13 : 8}
                class:list={["graph__node", { "graph__node--hub": n.hub }]}
                style={`--i:${i}`}
              />
            ))
          }
        </g>

        <circle class="graph__pulse" r="4.5" cx="74" cy="330" />
      </svg>
      <p class="hero__caption">
        Seis sistemas isolados. Uma ligação a gerir.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--navy);
    color: var(--on-navy-body);
    padding-block: clamp(8rem, 14vw, 11rem) clamp(4.5rem, 9vw, 7.5rem);
    overflow: hidden;
  }

  /* A single quiet wash so the right half reads as depth, not decoration */
  .hero::after {
    content: "";
    position: absolute;
    top: -20%;
    right: -12%;
    width: 62%;
    aspect-ratio: 1;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(6, 182, 212, 0.13) 0%,
      rgba(37, 99, 235, 0.07) 42%,
      transparent 68%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(0, 0.84fr);
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    color: var(--on-navy);
  }

  .hero__rule {
    display: block;
    width: 64px;
    height: 3px;
    margin-top: 1.6rem;
    background: var(--cyan);
    border-radius: 2px;
  }

  .hero__lead {
    max-width: 46ch;
    margin-top: 1.6rem;
    font-size: 1.125rem;
    line-height: 1.62;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }

  .hero__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }

  .graph {
    width: 100%;
    max-width: 440px;
    height: auto;
    overflow: visible;
  }

  .hero__caption {
    max-width: 44ch;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(182, 198, 222, 0.75);
    text-align: center;
  }

  /* ---- The moment ------------------------------------------------------ */

  .graph__links line {
    stroke: rgba(6, 182, 212, 0.34);
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .graph__node {
    fill: var(--navy);
    stroke: var(--cyan);
    stroke-width: 2.4;
  }

  .graph__node--hub {
    fill: var(--blue);
    stroke: var(--cyan);
    stroke-width: 2.4;
  }

  .graph__pulse {
    fill: #fff;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .graph__links line {
      animation: draw 620ms var(--ease) forwards;
      animation-delay: calc(var(--i) * 26ms);
    }

    .graph__node {
      transform-box: fill-box;
      transform-origin: center;
      animation: pop 460ms var(--ease) forwards;
      animation-delay: calc(320ms + var(--i) * 55ms);
    }

    .graph__pulse {
      offset-path: path("M74 330 L128 208 L272 190 L352 96");
      offset-rotate: 0deg;
      animation: cross 1100ms var(--ease) 1150ms forwards;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pop {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes cross {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  /* ---- Responsive ------------------------------------------------------ */

  @media (max-width: 56rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }

    .hero__copy {
      order: 1;
    }

    .hero__figure {
      order: 2;
    }

    .graph {
      max-width: 300px;
    }
  }
</style>
