# Security headers — served verbatim by Netlify and Cloudflare Pages.
#
# CSP notes:
# - style-src allows 'unsafe-inline' because Astro inlines the critical CSS at
#   build time. script-src does NOT need it: the only inline <script> on the
#   page is application/ld+json, which is never executed.
# - font-src is now 'self' only because Manrope is self-hosted.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

/brand/*
  Cache-Control: public, max-age=31536000, immutable